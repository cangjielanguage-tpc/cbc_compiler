## Mandatory properties

# One of: amd64, arm64
#arch=amd64

# One of: work, enduser
#mode=work


## Optional properties

# Path to flatc
#flatc=/usr/local/bin/flatc

# Path to graalvm native-image
#graalvm=/opt/graalvm/bin/native-image

# (-J-XX:ActiveProcessorCount) to limit the image-build peak memory
#graalvmParallelism=2

# Default CHIR serialization format version expected by the built compiler.
# Must have a matching core/chir-lib/schema/v<n> dir (see project/Env.scala).
#chir.defaultVersion=13002
