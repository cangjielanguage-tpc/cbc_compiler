## Mandatory properties

# One of: amd64, arm64
#arch=amd64

# One of: work, enduser
#mode=work


## Optional properties

# Path to flatc
#flatc=<jet-build-tools>/open-source/flatbuffers/flatbuffers-25.2.10-linux-x86_64/flatc

# Path to the native-image executable used by `sbt compiler/nativeImage` and `sbt cbcAsm/nativeImage`
#graalvm=<graalvm>/bin/native-image

# (-J-XX:ActiveProcessorCount) to limit the image-build peak memory
#graalvm.compilation.threads=2

