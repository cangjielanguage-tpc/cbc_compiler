func runBatch(input: Int64): Int64 {
    var x = input
    for (i in 0..16) {
        x = hotA(x)
    }
    for (i in 0..8) {
        x = hotB(x)
    }
    for (i in 0..2) {
        x = hotC(x)
    }

    x = hotGroup0(x)
    x = hotGroup1(x)
    x = hotGroup2(x)
    x = hotGroup3(x)
    x = hotGroup4(x)
    x = hotGroup5(x)
    x = hotGroup6(x)
    x = hotGroup7(x)
    return x
}

func worker(id: Int64): Int64 {
    var x = id + 1

    x = cold0(x)
    x = cold1(x)
    x = cold2(x)
    x = cold3(x)
    x = cold4(x)
    x = cold5(x)
    x = cold6(x)
    x = cold7(x)
    x = cold8(x)
    x = cold9(x)
    x = cold10(x)
