    x = cold16(x)
    x = cold17(x)
    x = cold18(x)
    x = cold19(x)
    x = cold20(x)
    x = cold21(x)
    x = cold22(x)
    x = cold23(x)
    x = cold24(x)
    x = cold25(x)
    x = cold26(x)
    x = cold27(x)
    x = cold28(x)
    x = cold29(x)
    x = cold30(x)
    x = cold31(x)
    x = cold32(x)
    x = cold33(x)
    x = cold34(x)
    x = cold35(x)
    x = cold36(x)
    x = cold37(x)
    x = cold38(x)
    x = cold39(x)
    x = cold40(x)
    x = cold41(x)
    x = cold42(x)
    x = cold43(x)
    x = cold44(x)
    x = cold45(x)
    x = cold46(x)
    x = cold47(x)
    x = cold48(x)
    x = cold49(x)
    x = cold50(x)
    x = cold51(x)
    x = cold52(x)
    x = cold53(x)
    x = cold54(x)
    x = cold55(x)
    x = cold56(x)
    x = cold57(x)
    x = cold58(x)
    x = cold59(x)
    x = cold60(x)
    x = cold61(x)
    x = cold62(x)
    x = cold63(x)

    var batches: Int64 = 0

    for (j in 0..800) {
        for (i in 0..1024) {
            x = runBatch(x)
        }
        batches += 1024
    }

    return batches
}

main(): Int64 {
    let started = MonoTime.now()

    let f0 = spawn { => worker(0) }
    let f1 = spawn { => worker(1) }
    let f2 = spawn { => worker(2) }
    let f3 = spawn { => worker(3) }

    let r0 = f0.get()
    let r1 = f1.get()
    let r2 = f2.get()
    let r3 = f3.get()

    let elapsed = MonoTime.now() - started
    let batches = r0 + r1 + r2 + r3

    // println("worker0: batches=${r0}")
    // println("worker1: batches=${r1}")
    // println("worker2: batches=${r2}")
    // println("worker3: batches=${r3}")

    // println("Total runBatch calls: ${batches}")
    // println("Expected runBatch -> hotA: ${16 * batches}")
    // println("Expected runBatch -> hotB: ${8 * batches}")
    // println("Expected runBatch -> hotC: ${2 * batches}")
    // println("Expected worker -> runBatch: ${batches}")
    // println("Expected each runBatch -> hotGroupN: ${batches}")
    // println("Expected each hotGroupK -> hotN: ${batches}")
    // println("Each worker -> coldN: 4")
    // println("Expected hot pairs: 76")
    // println("Expected cold pairs: 64")
    // println("Total expected hot-related calls: ${99 * batches}")
    // println("Total expected tracked calls: ${99 * batches + 256}")
    println(elapsed.toMilliseconds())

    return 0
}
