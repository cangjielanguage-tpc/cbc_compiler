func hotGroup0(input: Int64): Int64 {
    var x = input
    x = hot0(x)
    x = hot1(x)
    x = hot2(x)
    x = hot3(x)
    x = hot4(x)
    x = hot5(x)
    x = hot6(x)
    x = hot7(x)
    return x
}

