#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(dirname "$0")

executable="$1"
shift

cbc_file="${executable}.cbc"

if [ -f ./.foreignlibspath ]; then
    source ./.foreignlibspath
fi

if [ -f "$cbc_file" ]; then
    "$SCRIPT_DIR/../tools/bin/launcher" "$cbc_file" "${@}"
else
    echo "UNEXPECTED: no cbc for launcher"
    exit 111
fi
