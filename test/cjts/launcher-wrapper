#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(dirname "$0")

# Optional `env NAME=VALUE ...` prefix: export the settings and strip it.
if [[ "${1:-}" == "env" ]]; then
    shift
fi
while [[ $# -gt 0 && "$1" == ?*=* ]]; do
    export "$1"
    shift
done

executable="$1"
shift

cbc_file="${executable}.cbc"

if [ -f ./.foreignlibspath ]; then
    source ./.foreignlibspath
fi

if [ -f "$cbc_file" ]; then
    "$SCRIPT_DIR/../tools/bin/launcher" "$cbc_file" "${@}"
else
    echo "UNEXPECTED: no cbc for launcher"
    exit 111
fi
