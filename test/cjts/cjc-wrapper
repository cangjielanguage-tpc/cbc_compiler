#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(dirname "$0")

# Fallback to python script if there are (-l / -L) arguments.
for arg in "$@"; do
    if [[ "$arg" == "-l" || "$arg" == "-L" || "$arg" == -l?* || "$arg" == -L?* ]]; then
        exec "$SCRIPT_DIR/cjc-wrapper.py" "$@"
    fi
done

# Find cjc output: -o <out>
out=""

i=0
while [[ $i -lt $# ]]; do
    arg="${!i}"

    if [[ "$arg" == "-o" ]]; then
        next_index=$((i+1))
        next="${!next_index}"
        out="$next"
        i=$((i+2))
        continue
    fi

    i=$((i+1))
done

export TEMP_DIR=temps
mkdir -p $TEMP_DIR
cjc --save-temps $TEMP_DIR "${@:2}"

if [ -n "$out" ] && compgen -G $TEMP_DIR/*.chir > /dev/null; then
  if [[ "$out" != *.a ]]; then
    java -jar $SCRIPT_DIR/../tools/bin/cbc-compiler.jar $TEMP_DIR/*.chir +genlibrary -outputname="$out"
  fi
fi
